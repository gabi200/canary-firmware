# Canary dashboard config. Copy to .env to override (read at build / dev-server start).
# REST + WS base of the Canary backend:
#   unset  -> http://localhost:8000 (the default for `npm run dev`)
#   empty  -> same origin: REST calls go to relative /api/... URLs and the WebSocket to
#             ws(s)://<host that served the page>/api/v1/ws/... Use this when nginx serves
#             the dashboard and proxies /api (WebSocket included), e.g. on the Raspberry Pi hub:
#             VITE_API_BASE=
#   URL    -> that backend, e.g. http://192.168.1.20:8000
# The Docker image ignores .env files (web/.dockerignore) and always builds with an empty base.
VITE_API_BASE=http://localhost:8000
