# Canary backend configuration (env_prefix = CANARY_). Copy to .env to override.

# --- database ---
# SQLite (the Pi / docker compose use sqlite+aiosqlite:////data/canary.db on a volume).
# Postgres also works: postgresql+asyncpg://canary:canary@localhost:5432/canary
#   Timescale hypertables are created only if the server has the extension. No migrations:
#   a Postgres DB created by an earlier version needs, once:
#   ALTER TABLE sensor_readings ALTER COLUMN seq TYPE bigint;
# Redis is not used (config.py's CANARY_REDIS_URL / CANARY_USE_REDIS have no effect).
CANARY_DATABASE_URL=sqlite+aiosqlite:///./canary.db

# --- MQTT broker (Mosquitto; auth required — scripts/pi_setup.sh creates the `hub` user) ---
CANARY_MQTT_ENABLED=true
CANARY_MQTT_HOST=localhost
CANARY_MQTT_PORT=1883
# CANARY_MQTT_USERNAME=hub
# CANARY_MQTT_PASSWORD=
# Subscription filter: hardware <base>/status|availability + legacy topics.
CANARY_MQTT_SUBSCRIBE="#"
# Legacy canary.telemetry.v1 topic prefix (simulator).
CANARY_MQTT_TOPIC_PREFIX=canary/v1

# --- hardware nodes: where auto-registered ESP32 nodes land (move with PATCH /nodes/{id}) ---
CANARY_DEFAULT_BUILDING_ID=bld_007
CANARY_DEFAULT_ZONE_ID=zone_hallway

# --- retention: hourly, in batches of 2000 rows, prune raw snapshots (node_status), readings
# and occupancy older than N days (0 disables). Incidents, events, check-ins and audit are kept ---
CANARY_RETENTION_DAYS=14

# --- detection: consecutive clearing readings, from a device that reported the hazard,
# before its incident closes ---
# CANARY_CLEAR_HOLD_SAMPLES=3

# --- auth (CHANGE in production; scripts/pi_setup.sh generates it for docker compose) ---
CANARY_JWT_SECRET=dev-only-change-me

# --- bootstrap ---
CANARY_AUTO_CREATE_SCHEMA=true
CANARY_AUTO_SEED=true
