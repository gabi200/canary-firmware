# Keep the build context small and never bake local state or secrets into the image.
.venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
tests/

# Local SQLite databases (dev runs, test runs) and their journals
**/*.db
**/*.db-journal
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3

# Local settings/secrets (pydantic-settings would read /app/.env)
.env
.env.*

Dockerfile
.dockerignore
